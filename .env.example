# Database (SQLite for local dev — zero config)
DATABASE_URL="file:./dev.db"
# For production, switch prisma/schema.prisma datasource provider to "postgresql"
# and point this at your Postgres instance, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/zswap"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Payments — Flutterwave (mobile money, cards) — https://flutterwave.com
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# Payments — Paystack (alternative gateway) — https://paystack.com
PAYSTACK_SECRET_KEY=""

# Payments — DPO (alternative gateway, strong Zambia mobile money coverage)
DPO_COMPANY_TOKEN=""

# File uploads — choose one
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Real-time chat — choose one
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
# or run the bundled Socket.io server and set:
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# SMS / OTP gateway (e.g. Africa's Talking, Twilio Verify)
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_USERNAME=""
